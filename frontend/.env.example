# API base URL (Express backend)
VITE_API_URL=http://localhost:5000/api

# ISO currency code used by formatPrice (SRS 17.1: configurable currency)
VITE_CURRENCY=USD

# Flat shipping fee shown in the cart (the backend computes the real total)
VITE_SHIPPING_FEE=0

# Fake backend for the frontend (MSW). Set to true to run without the API.
VITE_USE_MOCKS=false
VITE_MOCK_DELAY=250
VITE_PLATFORM_FEE_PERCENT=10